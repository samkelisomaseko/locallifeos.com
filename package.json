{
  "name": "locallifeos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LocalLife OS — a hyperlocal community OS. Keep 100% of the current UI & UX.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node --env-file-if-exists=.env server/serve.mjs",
    "serve:api": "node --env-file-if-exists=.env --watch server/api.mjs",
    "db:generate": "drizzle-kit generate --config drizzle.config.mjs",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate --config drizzle.config.mjs",
    "db:studio": "npx drizzle-kit studio --config drizzle.config.mjs",
    "lint": "eslint server vite.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.49.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9"
  }
}
