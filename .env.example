# LocalLife OS — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# ── Server ──────────────────────────────────────────────────────
PORT=5173

# ── API server (Phase 2) ─────────────────────────────────────────
# PostgreSQL connection string (Neon free tier recommended).
# Get it from your Neon project dashboard: Connection string → pooled.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PORT_API=3001
# Comma-separated origins allowed to call the API (CORS, credentials)
APP_ORIGIN=http://localhost:5173,http://localhost:4173
RATE_LIMIT_MAX=100
LOG_LEVEL=info

# ── Third-party API keys (server-side only — never ship to client) ──
OPENWEATHER_API_KEY=your_openweather_api_key_here
# Google Maps key is injected into the client at build time (VITE_ prefix),
# restricted by HTTP referrer in Google Cloud Console — never a server secret.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here