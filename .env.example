# LocalLife OS — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# ── Server ──────────────────────────────────────────────────────
PORT=5173

# ── Third-party API keys (server-side only — never ship to client) ──
OPENWEATHER_API_KEY=your_openweather_api_key_here
# Google Maps key is injected into the client at build time (VITE_ prefix),
# restricted by HTTP referrer in Google Cloud Console — never a server secret.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here